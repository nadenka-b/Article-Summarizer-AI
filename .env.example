# Application
DEBUG=true
PROJECT_NAME=Article-Summarizer-AI
EVAL_MODE=agents
ACTIVE_LEARNING_ENABLED=true

# Summarization engine: auto | ollama | huggingface
SUMMARIZATION_ENGINE=auto

# Summary mode: abstract | section_wise
SUMMARY_MODE=abstract
MAX_ARTICLE_LENGTH=50000

# Ollama
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
LLM_MODEL=qwen2.5:7b
SUMMARIZER_MODEL=qwen2.5:7b
CRITIC_MODEL=qwen2.5:7b
EDITOR_MODEL=qwen2.5:7b
VALIDATOR_MODEL=qwen2.5:7b
ENSEMBLE_MODELS=qwen2.5:7b,llama3.1:8b


# Services
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=article_knowledge
REDIS_URL=redis://localhost:6379/0

# Database
DATABASE_URL=sqlite+aiosqlite:///./summarizer.db

# Security (сгенерируйте свой ключ!)
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080