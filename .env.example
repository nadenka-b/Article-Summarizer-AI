# Application
DEBUG=true
PROJECT_NAME=Article-Summarizer-AI
EVAL_MODE=agents
ACTIVE_LEARNING_ENABLED=true
ADMIN_EMAIL=admin@example.com

# Summary mode: abstract | section_wise
SUMMARY_MODE=abstract
MAX_ARTICLE_LENGTH=50000

# LM Studio (OpenAI-совместимый сервер на хосте)
LMSTUDIO_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen2.5-7b-instruct-1m
LLM_TIMEOUT_SECONDS=600
LLM_MAX_TOKENS=4000
# Необязательные переопределения модели для агентов (пусто → LMSTUDIO_MODEL):
# SUMMARIZER_MODEL=
# CRITIC_MODEL=
# EDITOR_MODEL=

# Чанкинг длинных статей (этап 8)
SUMMARIZER_DIRECT_CHARS=6000
CHUNK_SIZE_CHARS=3500
CHUNK_OVERLAP_CHARS=300

# Services
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=article_knowledge
# Локальный файловый режим Qdrant без сервера (пусто — HTTP):
# QDRANT_LOCAL_PATH=./data/qdrant_storage
REDIS_URL=redis://localhost:6379/0

# Embeddings (гибридный RAG)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# Гибридный поиск
HYBRID_TOP_K=5
RRF_K=60
KB_SEARCH_TEXT_CHARS=2000

# Database
DATABASE_URL=sqlite+aiosqlite:///./summarizer.db

# Security (сгенерируйте свой ключ!)
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080